module pc_target_calc (
	condition_met_out,
	predicted_taken_out,
	branch_out,
	mispredict1,
	actual_taken1,
	devpor,
	devclrn,
	devoe);
input 	condition_met_out;
input 	predicted_taken_out;
input 	branch_out;
output 	mispredict1;
output 	actual_taken1;

// Design Ports Information

input 	devpor;
input 	devclrn;
input 	devoe;

wire gnd;
wire vcc;
wire unknown;

